# ══════════════════════════════════════════════════════════
# Sirius SG-SST — Plantilla de variables de entorno
#
# Generado por: npm run gen:env-example
# No edites este archivo a mano: se regenera desde .env.local.
#
# Copia este archivo a .env.local y reemplaza los placeholders con los
# valores reales. Verifica con: npm run check:env
# ══════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════
# URL base para enlaces de firma (LAN)
# ══════════════════════════════════════════════════════════
NEXT_PUBLIC_SIGNING_BASE_URL=https://ejemplo.com

# ══════════════════════════════════════════════════════════
# Airtable - Conexión general
# Token Universal (acceso a todo el espacio de trabajo)
# ══════════════════════════════════════════════════════════
AIRTABLE_API_TOKEN=tu_token_aqui
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ══════════════════════════════════════════════════════════
# Airtable - IDs de Tablas
# ══════════════════════════════════════════════════════════
# Tabla "Personal" — datos de empleados, credenciales, accesos
AIRTABLE_PERSONAL_TABLE_ID=tblXXXXXXXXXXXXXX
# Tabla "Sistemas y Aplicaciones" — catálogo de apps corporativas
AIRTABLE_SISTEMAS_TABLE_ID=tblXXXXXXXXXXXXXX
# Tabla "Roles y Permisos" — catálogo de roles organizacionales
AIRTABLE_ROLES_TABLE_ID=tblXXXXXXXXXXXXXX

# ══════════════════════════════════════════════════════════
# Airtable - Field IDs de tabla "Personal"
# ══════════════════════════════════════════════════════════
# Código único del empleado (ej: EMP-001)
AIRTABLE_PF_ID_EMPLEADO=fldXXXXXXXXXXXXXX
# URL de la foto de perfil del empleado
AIRTABLE_PF_FOTO_PERFIL=fldXXXXXXXXXXXXXX
# Nombre completo del empleado
AIRTABLE_PF_NOMBRE_COMPLETO=fldXXXXXXXXXXXXXX
# Tipo de personal (interno, contratista, etc.)
AIRTABLE_PF_TIPO_PERSONAL=fldXXXXXXXXXXXXXX
# Rol del empleado en la organización
AIRTABLE_PF_ROL=fldXXXXXXXXXXXXXX
# Correo electrónico corporativo
AIRTABLE_PF_CORREO=fldXXXXXXXXXXXXXX
AIRTABLE_PF_FECHA_NACIMIENTO=fldXXXXXXXXXXXXXX
AIRTABLE_PF_FECHA_INCORPORACION=fldXXXXXXXXXXXXXX
# Número de teléfono de contacto
AIRTABLE_PF_TELEFONO=fldXXXXXXXXXXXXXX
# Número de documento de identidad (cédula)
AIRTABLE_PF_NUMERO_DOCUMENTO=fldXXXXXXXXXXXXXX
# Hash de la contraseña del empleado
AIRTABLE_PF_PASSWORD=fldXXXXXXXXXXXXXX
# IDs de accesos/apps asignadas al empleado (linked records)
AIRTABLE_PF_ACCESOS_ASIGNADOS=fldXXXXXXXXXXXXXX
# Estado de actividad del empleado (activo/inactivo)
AIRTABLE_PF_ESTADO_ACTIVIDAD=fldXXXXXXXXXXXXXX
# Áreas a las que pertenece el empleado
AIRTABLE_PF_AREAS=fldXXXXXXXXXXXXXX
# Rol/Cargo del empleado (lookup "Rol (from Rol)")
AIRTABLE_PF_ROL_LOOKUP=fldXXXXXXXXXXXXXX
# Nivel de acceso al sistema (link a tabla "Niveles_Acceso")
AIRTABLE_PF_NIVEL_SISTEMA=fldXXXXXXXXXXXXXX
# Nombre del nivel (lookup "Nivel Acceso (from Nivel_Sistema_Nuevo)")
AIRTABLE_PF_NIVEL_LOOKUP=fldXXXXXXXXXXXXXX
# Orden jerárquico del nivel, 1 = Super Admin (lookup)
AIRTABLE_PF_NIVEL_ORDEN_LOOKUP=fldXXXXXXXXXXXXXX

# ══════════════════════════════════════════════════════════
# Airtable - Field IDs de tabla "Sistemas y Aplicaciones"
# ══════════════════════════════════════════════════════════
# Nombre de la aplicación (ej: "Sirius SG-SST")
AIRTABLE_SF_NOMBRE_APP=fldXXXXXXXXXXXXXX
# Código interno de la aplicación
AIRTABLE_SF_CODIGO_APP=fldXXXXXXXXXXXXXX

# ══════════════════════════════════════════════════════════
# Airtable - Field IDs de tabla "Roles y Permisos"
# ══════════════════════════════════════════════════════════
# Nombre del rol (ej: "Inspector SST")
AIRTABLE_RF_NOMBRE_ROL=fldXXXXXXXXXXXXXX


API_KEY_SIRIUS_SG_SST=tu_clave_aqui

