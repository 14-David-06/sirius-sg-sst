# ══════════════════════════════════════════════════════════
# AES Encryption - Clave para cifrado de firmas digitales
# ══════════════════════════════════════════════════════════
AES_SIGNATURE_SECRET=tu_secreto_aqui

# ══════════════════════════════════════════════════════════
# Contraseña Hexadecimal (64 dígitos) - Desbloqueo de firmas
# Solo quien tenga esta clave puede visualizar firmas descifradas
# ══════════════════════════════════════════════════════════
AES_DECRYPT_PASSWORD=tu_password_aqui

